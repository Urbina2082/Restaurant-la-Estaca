
---
const qualities = [
  {
    number: "01",
    title: "TRADICIÓN",
    description: "Una marca reconocible en Sabinas."
  },
  {
    number: "02",
    title: "CALIDAD",
    description: "Producto y preparación que hablan por sí mismos."
  },
  {
    number: "03",
    title: "PERSONALIDAD",
    description: "Platillos, nombres y detalles que hacen que La Estaca sea La Estaca."
  }
];
---

<section
  id="nosotros"
  class="relative overflow-hidden bg-[#faf9f5] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <!-- Textura de fondo -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#493d32 0.6px, transparent 0.6px); background-size: 5px 5px;"
  ></div>

  <div
    class="relative mx-auto grid max-w-[1120px] grid-cols-1 items-center gap-12 lg:grid-cols-[1.25fr_0.9fr] lg:gap-16"
  >

    <!-- CONTENIDO IZQUIERDO -->
    <div class="flex flex-col">

      <!-- Etiqueta -->
      <span
        class="mb-4 text-[11px] font-bold uppercase tracking-[0.32em] text-[#a65b32]"
      >
        LA CASA
      </span>

      <!-- Título -->
      <h2
        class="max-w-[680px] text-[clamp(2.8rem,6.2vw,5rem)] font-black uppercase leading-[0.88] tracking-[-0.045em] text-[#211b17]"
        style="font-family: 'Anton', sans-serif;"
      >
        NO ES SOLO COMIDA.
        <span class="block text-[#00863d]">
          ES LA ESTACA.
        </span>
      </h2>

      <!-- Descripción -->
      <p
        class="mt-7 max-w-[560px] text-[15px] leading-7 text-[#898078] sm:text-base sm:leading-8"
      >
      En La Estaca, nos distinguimos por preservar la tradición gastronómica de Sabinas, ofreciendo calidad, buen servicio y una experiencia que nos enorgullece compartir en cada visita.
      </p>

      <!-- CARACTERÍSTICAS -->
      <div class="mt-10 grid grid-cols-1 gap-7 sm:grid-cols-3 sm:gap-0">

        {qualities.map((item, index) => (
          <article
            class:list={[
              "flex flex-col",
              "sm:px-5 lg:px-6",
              index === 0 && "sm:pl-5",
              index > 0 && "sm:border-l sm:border-[#e9e3da]"
            ]}
          >
            <span
              class="text-[38px] font-black leading-none text-[#dfc9b9]"
              style="font-family: 'Anton', sans-serif;"
            >
              {item.number}
            </span>

            <h3
              class="mt-5 text-sm font-black tracking-[0.12em] text-[#211b17]"
              style="font-family: 'Anton', sans-serif;"
            >
              {item.title}
            </h3>

            <p class="mt-3 max-w-[190px] text-sm leading-[1.65] text-[#898078]">
              {item.description}
            </p>
          </article>
        ))}

      </div>
    </div>

    <!-- IMAGEN DERECHA -->
    <div class="relative mx-auto w-full max-w-[480px] lg:ml-auto">

      <div
        class="relative aspect-[4/5] overflow-hidden rounded-[28px] bg-[#ded5ca] sm:rounded-[34px]"
      >
        <img
          src="/C.avif"
          alt="Interior y ambiente del restaurante La Estaca"
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />

        <!-- Degradado inferior -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"
        ></div>

        <!-- Tarjeta flotante -->
        <div class="absolute bottom-4 left-4 right-4 rounded-[22px] border border-white/40 bg-white/80 p-4 shadow-lg backdrop-blur-xl sm:bottom-5 sm:left-5 sm:right-5 sm:p-5">

          <h3
            class="text-base font-black tracking-[0.12em] text-[#00863d] sm:text-lg"
            style="font-family: 'Anton', sans-serif;"
          >
            Sabinas, Coahuila
          </h3>

          <p class="mt-1 text-xs leading-relaxed text-[#81766c] sm:text-sm">
            Un lugar de reuniones, celebraciones y antojos que regresan.
          </p>

        </div>
      </div>

    </div>

  </div>
</section>
