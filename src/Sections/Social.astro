
---
const socials = [
  {
    name: "Instagram",
    url: "https://www.instagram.com/restlaestaca/",
    icon: "instagram"
  },
  {
    name: "Facebook",
    url: "https://www.facebook.com/laestaca.web?locale=es_LA",
    icon: "facebook"
  },
  {
    name: "TikTok",
    url: "https://www.tiktok.com/@laestacasabinas",
    icon: "tiktok"
  }
];

const photos = [
  {
    src: "/9.avif",
    alt: "Carne a la parrilla"
  },
  {
        src: "/10.avif",
    alt: "Tacos de arrachera"
  },
  {
    src: "/11.avif",
    alt: "Platillo gratinado"
  },
  {
      src: "/12.avif",
    alt: "Tacos preparados al momento"
  }
];
---

<section
  id="redes"
  class="overflow-hidden bg-[#faf9f5] px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24"
>
  <div class="mx-auto grid max-w-[1120px] grid-cols-1 items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">

    <!-- CONTENIDO IZQUIERDO -->
    <div>

      <h2
        class="max-w-[390px] text-[clamp(2.7rem,5vw,4rem)] font-black uppercase leading-[0.88] tracking-[-0.04em] text-[#211b17]"
        style="font-family: 'Anton', sans-serif;"
      >
        SÍGUENOS EN
        <span class="text-[#00863d]">LA ESTACA</span>
      </h2>

      <p class="mt-4 text-sm leading-6 text-[#928980]">
        Porque el antojo también empieza viendo.
      </p>

      <!-- REDES SOCIALES -->
      <div class="mt-6 flex max-w-[390px] flex-wrap gap-2.5">

        {socials.map((social) => (
          <a
            href={social.url}
            target={social.name !== "WhatsApp" ? "_blank" : undefined}
            rel={social.name !== "WhatsApp" ? "noopener noreferrer" : undefined}
            aria-label={`Visitar ${social.name} de La Estaca`}
            class="inline-flex min-h-[42px] items-center gap-2 rounded-full border border-[#eeeae1] bg-[#fffefa] px-4 text-xs font-semibold text-[#39312b] transition-all duration-300 hover:border-[#00863d]/30 hover:bg-[#00863d]/5 hover:text-[#00863d]"
          >

            {social.icon === "instagram" && (
              <svg class="h-4 w-4 text-[#329e68]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
              </svg>
            )}

            {social.icon === "facebook" && (
              <svg class="h-4 w-4 text-[#329e68]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.6V3.9c-.8-.1-1.7-.2-2.6-.2-2.6 0-4.3 1.6-4.3 4.5V10H7v3h2.8v8h3.7Z"/>
              </svg>
            )}

            {social.icon === "tiktok" && (
              <svg class="h-4 w-4 text-[#329e68]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.6 7.2a5.8 5.8 0 0 1-3.5-1.2V15a6 6 0 1 1-6-6c.3 0 .6 0 .9.1v3.3a2.8 2.8 0 1 0 2.1 2.7V3h3.3c.2 2 1.4 3.7 3.2 4.4v3.4Z"/>
              </svg>
            )}

            {social.icon === "whatsapp" && (
              <svg class="h-4 w-4 text-[#329e68]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 11.5a8.4 8.4 0 0 1-12.5 7.3L3 20l1.3-4.3A8.4 8.4 0 1 1 20 11.5Z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 8.5c.5 2.5 2.5 4.5 5 5"/>
              </svg>
            )}

            {social.name}
          </a>
        ))}

      </div>

    </div>

    <!-- GALERÍA DE FOTOGRAFÍAS -->
    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4 sm:gap-3">

      {photos.map((photo) => (
        <a
          href="#galeria"
          aria-label={`Ver galería: ${photo.alt}`}
          class="group relative aspect-square overflow-hidden rounded-[17px] bg-[#e8dfd3] sm:rounded-[20px]"
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/25">
            <svg
              class="h-7 w-7 text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
            </svg>
          </div>
        </a>
      ))}

    </div>

  </div>
</section>
