---
const location = {
  name: "LA ESTACA · SABINAS",
  address: "Carretera 57, Raúl López Sánchez 354, Col. del Valle, 26788 Sabinas, Coah.",
  phone: "861 612 8722",
  mapsUrl: "https://www.google.com/maps/search/?api=1&query=La+Estaca+Sabinas+Coahuila",
};

const hours = [
  { day: "Lunes", time: "Cerrado", closed: true },
  { day: "Martes", time: "12:00 p. m. – 11:00 p. m." },
  { day: "Miércoles", time: "12:00 p. m. – 11:00 p. m." },
  { day: "Jueves", time: "12:00 p. m. – 11:00 p. m." },
  { day: "Viernes", time: "12:00 p. m. – 11:00 p. m." },
  { day: "Sábado", time: "12:00 p. m. – 11:00 p. m." },
  { day: "Domingo", time: "12:00 p. m. – 10:00 p. m." },
];
---

<section
  id="sucursales"
  class="relative overflow-hidden bg-[#f7f5ed] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <!-- Textura -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#493d32 0.6px, transparent 0.6px); background-size: 5px 5px;"
  ></div>

  <div class="relative mx-auto max-w-[1120px]">

    <!-- ENCABEZADO -->
    <div class="mb-10 flex flex-col justify-between gap-5 md:mb-12 md:flex-row md:items-end">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-[0.32em] text-[#a65b32]">
          UBICACIÓN
        </span>

        <h2
          class="mt-2 text-[clamp(2.5rem,6vw,5rem)] font-black uppercase leading-[0.9] tracking-[-0.04em] text-[#211b17]"
          style="font-family: 'Anton', sans-serif;"
        >
          ENCUÉNTRANOS
        </h2>
      </div>

      <p class="max-w-[380px] text-sm leading-6 text-[#928980] sm:text-base">
        Visítanos en Sabinas, Coahuila. Consulta nuestra ubicación y horarios de atención.
      </p>
    </div>

    <!-- TARJETAS -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-[1.15fr_0.85fr] lg:gap-6">

      <!-- SUCURSAL -->
      <article
        class="rounded-[26px] border border-[#eeeae1] bg-[#fffefa] p-6 shadow-[0_18px_45px_rgba(45,35,20,0.07)] sm:p-7"
      >
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
          <h3
            class="text-base font-black text-[#211b17] sm:text-lg"
            style="font-family: 'Anton', sans-serif;"
          >
            {location.name}
          </h3>

          <span class="inline-flex items-center gap-2 rounded-full bg-[#e5f0e4] px-3 py-1.5 text-[10px] font-bold tracking-widest text-[#27844b]">
            <span class="h-2.5 w-2.5 rounded-full bg-[#16a34a]"></span>
            SUCURSAL PRINCIPAL
          </span>
        </div>

        <!-- INFORMACIÓN -->
        <div class="space-y-4">

          <!-- Dirección -->
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#bd8968]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657 13.414 20.9a2 2 0 0 1-2.828 0l-4.243-4.243a8 8 0 1 1 11.314 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <p class="text-sm leading-6 text-[#91877d]">
              {location.address}
            </p>
          </div>

          <!-- Teléfono -->
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#bd8968]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h3.28a2 2 0 0 1 1.97 1.61l.5 2.5a2 2 0 0 1-.57 1.85l-1.5 1.5a16 16 0 0 0 5.86 5.86l1.5-1.5a2 2 0 0 1 1.85-.57l2.5.5A2 2 0 0 1 22 16.72V20a2 2 0 0 1-2 2h-1C10.16 22 2 13.84 2 4V3" />
            </svg>
            <p class="text-sm leading-6 text-[#91877d]">
              {location.phone}
            </p>
          </div>
        </div>

        <!-- GOOGLE MAPS -->
        <a
          href={location.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 flex min-h-[50px] w-full items-center justify-center gap-2 rounded-full bg-[#00863d] px-5 text-xs font-bold tracking-[0.15em] text-white transition-all duration-300 hover:bg-[#006e32] hover:shadow-lg"
        >
          VER EN GOOGLE MAPS
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </article>

      <!-- HORARIOS -->
      <article
        class="relative overflow-hidden rounded-[26px] border border-[#eeeae1] bg-[#fffefa] p-6 shadow-[0_18px_45px_rgba(45,35,20,0.07)] sm:p-7"
      >
        <!-- Cuadrícula decorativa -->
        <div
          class="pointer-events-none absolute inset-0 opacity-60"
          style="background-image: linear-gradient(#e9e9dc 1px, transparent 1px), linear-gradient(90deg, #e9e9dc 1px, transparent 1px); background-size: 28px 28px;"
        ></div>

        <div class="relative">
          <span class="text-[10px] font-bold tracking-[0.3em] text-[#b47c58]">
            HORARIOS DE ATENCIÓN
          </span>

          <h3
            class="mt-3 text-2xl font-black text-[#211b17] sm:text-3xl"
            style="font-family: 'Anton', sans-serif;"
          >
            TE ESPERAMOS
          </h3>

          <!-- LISTA DE HORARIOS -->
          <div class="mt-6 space-y-0">
            {hours.map((item) => (
              <div class="flex items-center justify-between gap-3 border-b border-[#eae5db] py-3 last:border-0">
                <span class="text-sm font-semibold text-[#39312b]">
                  {item.day}
                </span>

                <span class:list={[
                  "text-right text-xs font-medium sm:text-sm",
                  item.closed ? "text-[#c15d4b]" : "text-[#81766c]"
                ]}>
                  {item.time}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- UBICACIÓN -->
        <div class="relative mt-6 flex items-center gap-3 border-t border-[#eae5db] pt-5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#f8e9e3]">
            <svg class="h-5 w-5 text-[#e76b57]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657 13.414 20.9a2 2 0 0 1-2.828 0l-4.243-4.243a8 8 0 1 1 11.314 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-[#39312b]">
              Sabinas, Coahuila, México
            </p>
            <p class="mt-1 text-xs text-[#a49a90]">
              Carretera 57
            </p>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>