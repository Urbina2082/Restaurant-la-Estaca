---
const links = [
  { name: "Inicio", href: "#inicio" },
  { name: "Sucursales", href: "#sucursales" },
  { name: "Menú", href: "#menu" },
  { name: "Reseñas", href: "#resenas" },
  { name: "Galería", href: "#galeria" },
  { name: "Promociones", href: "#promociones" },
  { name: "Contacto", href: "#contacto" },
];
---

<section
  id="inicio"
  class="relative isolate min-h-[750px] h-screen w-full overflow-hidden bg-black"
>
  <!-- Imagen de fondo -->
<div
  class="absolute inset-0 -z-20 bg-cover bg-center bg-no-repeat
  bg-[url('/f2.avif')]
  md:bg-[url('/f.avif')]"
></div>

  <!-- Oscurecimiento de imagen -->
  <div class="absolute inset-0 -z-10 bg-black/45"></div>

  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/40 to-black/10"
  ></div>

  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-transparent to-black/20"
  ></div>

  <!-- NAVBAR -->
  <header class="absolute top-0 z-30 w-full px-4 pt-4 sm:px-8 lg:px-10">
    <nav
      class="mx-auto flex max-w-[1120px] items-center justify-between rounded-full border border-white/40 bg-white/75 px-4 py-2.5 shadow-xl shadow-black/10 backdrop-blur-xl sm:px-6"
    >
      <!-- Logo -->
      <a href="#inicio" class="flex shrink-0 items-center gap-2.5">
        <img
          src="/logo.avif"
          alt="La Estaca"
          class="h-10 w-10 rounded-full bg-white object-contain"
        />
        <span class="font-bold text-[#00863d] text-lg tracking-tight">
          La Estaca
        </span>
      </a>

      <!-- Links escritorio -->
      <div class="hidden items-center gap-5 lg:flex">
        {links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-neutral-700 transition-colors hover:text-[#00863d]"
          >
            {link.name}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <a
        href="#menu"
        class="hidden rounded-full bg-[#00863d] px-6 py-3 text-xs font-bold tracking-widest text-white transition-all hover:bg-[#006e32] sm:inline-flex"
      >
        VER MENÚ
      </a>

      <!-- Botón móvil -->
      <a
        href="#menu"
        class="rounded-full bg-[#00863d] px-5 py-2.5 text-xs font-bold tracking-wider text-white lg:hidden"
      >
        MENÚ
      </a>
    </nav>
  </header>

  <!-- CONTENIDO HERO -->
  <div
    class="mx-auto flex h-full max-w-[1120px] flex-col justify-center px-6 pb-16 pt-28 sm:px-10 lg:px-8"
  >
    <div class="max-w-[680px]">

      <!-- Ubicación -->
      <div
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/40 px-4 py-2 backdrop-blur-md"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.657 16.657 13.414 20.9a2 2 0 0 1-2.828 0l-4.243-4.243a8 8 0 1 1 11.314 0Z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
          />
        </svg>

        <span class="text-[10px] font-bold tracking-[0.22em] text-white sm:text-xs">
          SABINAS · COAHUILA
        </span>
      </div>

      <!-- Título -->
      <h1
        class="font-black uppercase leading-[0.85] tracking-[-0.045em] text-white text-[clamp(4rem,11vw,8.5rem)]"
        style="font-family: 'Anton', sans-serif;"
      >
        LA ESTACA
      </h1>

      <!-- Subtítulo -->
      <h2
        class="mt-5 text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-4xl"
        style="font-family: 'Anton', sans-serif;"
      >EL QUE NO CONOCE LA ESTACA NO CONOCE SABINAS.
      </h2>

      <!-- Descripción -->
      <p
        class="mt-5 max-w-[570px] text-sm leading-5 text-white/75 sm:text-base sm:leading-6"
      >
       Tradición y calidad que distinguen a Sabinas. Una propuesta gastronómica que honra el sabor de la buena carne, acompañada de la esencia y hospitalidad que caracterizan a La Estaca.
      </p>

      <!-- Botones -->
      <div class="mt-8 flex flex-col gap-3 min-[400px]:flex-row">
        <a
          href="#menu"
          class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#00863d] px-9 text-xs font-bold tracking-[0.18em] text-white transition-all duration-300 hover:scale-105 hover:bg-[#006e32]"
        >
          VER MENÚ
        </a>

        <a
          href="#sucursales"
          class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/25 bg-black/30 px-8 text-xs font-bold tracking-[0.16em] text-white backdrop-blur-md transition-all duration-300 hover:bg-white/15"
        >
          ¿CÓMO LLEGAR?
        </a>
      </div>

      <!-- Texto inferior -->
      <p class="mt-8 text-xs font-medium text-white/55">
        Sabinas, Coahuila · Desde hace años haciendo que se te antoje volver.
      </p>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#sucursales"
    aria-label="Desplazarse hacia abajo"
    class="absolute bottom-7 left-1/2 -translate-x-1/2 text-white/80 transition-transform hover:translate-y-1"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-7 w-7"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
    </svg>
  </a>
</section>
