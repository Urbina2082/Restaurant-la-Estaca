---
const reviews = [
  {
    author: "Luis Angel Alonso Rdz",
    rating: true,
    date: "Hace 2 meses",
    comment: "Excelente rest. Si pasas por Sabinas, tienes que comer aquí. Excelente servicio, muy buenos los platillos. Precios razonables."
  },
  {
    author: "Jorge Cervantes",
    rating: true,
    date: "Hace 4 meses",
    comment: "Muy buen ambiente para pasarla en familia o festejar un cumpleaños, personal muy atento y amable, la comida muy bien preparada, recomiendo la arrachera con salsa tampiqueña es suficiente para 4 personas."
  },
  {
    author: "Abraham Villarreal Rojas",
    rating:true,
    date: "Hace 3 meses",
    comment: "Se los recomiendo, una gran opción para consumir alimentos. Recuerda que vas a gastar un poco más, pero porciones generosos y con un buen sabor de boca y el gran trato amable que caracteriza a la gente de la región."
  },
  {
    author: "Raquel Macias",
    rating: true,
    date: "Hace 4 meses",
    comment: "El servicio al cliente tiene área de oportunidad, nada que no se pueda revisar poniendo un poco mas de atención. La comida es estupenda, los cortes deliciosos"
  }
];

const googleReviewsUrl =
  "https://www.google.com/maps/search/?api=1&query=La+Estaca+Sabinas+Coahuila";
---

<section
  id="resenas"
  class="overflow-hidden bg-[#f7f5ed] py-20 sm:py-24 lg:py-28"
>
  <div class="mx-auto max-w-[1120px] px-5 sm:px-8 lg:px-0">

    <!-- ENCABEZADO -->
    <div class="mb-10 sm:mb-12">
      <span class="text-[11px] font-bold uppercase tracking-[0.32em] text-[#a9673d]">
        OPINIONES
      </span>

      <h2
        class="mt-2 text-[clamp(3rem,6vw,5rem)] font-black uppercase leading-[0.9] tracking-[-0.04em] text-[#211b17]"
        style="font-family: 'Anton', sans-serif;"
      >
        LO DICE LA GENTE
      </h2>
    </div>

  </div>

  <!-- TARJETAS DE RESEÑAS -->
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-4 px-5 sm:grid-cols-2 sm:px-8 lg:grid-cols-4 lg:px-0">

    {reviews.map((review) => (
      <article
        class="flex min-h-[190px] flex-col justify-between rounded-[25px] border border-[#eeeae1] bg-[#fffefa] p-5 shadow-[0_12px_30px_rgba(45,35,20,0.06)] sm:p-6"
      >

        <div>
          <div class="mb-5 flex gap-1" aria-label={`${review.rating} de 5 estrellas`}>
  {Array.from({ length: 5 }).map(() => (
    <svg
      class="h-5 w-5 fill-[#a9673d] text-[#a9673d]"
      viewBox="0 0 24 24"
    >
      <path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.57l-5.9 3.11 1.13-6.58-4.78-4.66 6.6-.96L12 2.5z" />
    </svg>
  ))}
</div>

          <!-- COMENTARIO -->
          <p class="text-sm leading-6 text-[#81776e]">
            "{review.comment}"
          </p>
        </div>

        <!-- AUTOR -->
        <div class="mt-6">
          <h3 class="text-sm font-bold text-[#29221d]">
            {review.author}
          </h3>

          <p class="mt-1 text-xs text-[#a49a90]">
            {review.date}
          </p>
        </div>

      </article>
    ))}

  </div>

  <!-- BOTÓN GOOGLE -->
  <div class="mx-auto mt-10 max-w-[1120px] px-5 sm:px-8 lg:px-0">
    <a
      href={googleReviewsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-[#00863d]/25 bg-[#00863d]/[0.06] px-7 text-[11px] font-bold tracking-[0.17em] text-[#00863d] transition-all duration-300 hover:bg-[#00863d] hover:text-white"
    >
      VER TODAS LAS RESEÑAS EN GOOGLE
      <svg
        class="ml-2 h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
      </svg>
    </a>
  </div>

</section>
