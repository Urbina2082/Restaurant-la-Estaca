---
const photos = [
  {
    src: "/1.avif",
   
    class: "col-span-2 row-span-2"
  },
  {
    src: "/2.avif",
   
    class: "col-span-1 row-span-1"
  },
  {
    src: "/3.avif",
    
    class: "col-span-1 row-span-1"
  },

  {
    src: "/5.avif",
  
    class: "col-span-2 row-span-1"
  },
  {
   src: "/6.avif",
   
    class: "col-span-1 row-span-1"
  },
  {
   src: "/7.avif",
   
    class: "col-span-1 row-span-1"
  },
  {
  src: "/8.avif",
   
    class: "col-span-2 row-span-1"
  }

];
---

<section
  id="galeria"
  class="bg-[#faf9f5] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <div class="mx-auto max-w-[1120px]">

    <!-- ENCABEZADO -->
    <div class="mb-9 sm:mb-12">
      <h2
        class="text-[clamp(2.8rem,6vw,4.5rem)] font-black uppercase leading-[0.95] tracking-[-0.04em] text-[#211b17]"
        style="font-family: 'Anton', sans-serif;"
      >
        ASÍ SE VIVE
        <span class="text-[#00863d]">LA ESTACA</span>
      </h2>
    </div>

    <!-- MOSAICO -->
    <div
      id="gallery-grid"
      class="grid auto-rows-[105px] grid-cols-2 gap-2.5 sm:auto-rows-[145px] sm:gap-3 lg:auto-rows-[145px] lg:grid-cols-4 lg:gap-3"
    >
      {photos.map((photo, index) => (
        <button
          type="button"
          class:list={[
            "gallery-item group relative isolate overflow-hidden rounded-[17px] bg-[#e8dfd3] text-left sm:rounded-[22px]",
            photo.class,
            "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#00863d]"
          ]}
          data-index={index}
          aria-label={`Ampliar fotografía: ${photo.alt}`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/15"></div>

          <span class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-black/20 text-white opacity-0 backdrop-blur-md transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6M9 21H3v-6m18-6-7-7M3 15l7 7" />
            </svg>
          </span>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- LIGHTBOX -->
<dialog
  id="gallery-lightbox"
  class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-white backdrop:bg-black/95"
  aria-label="Visor de fotografías"
>
  <div class="flex h-full w-full flex-col items-center justify-center p-4 sm:p-8">

    <!-- BARRA SUPERIOR -->
    <div class="mb-4 flex w-full max-w-6xl items-center justify-between">
      <span id="gallery-counter" class="text-sm font-medium tracking-widest text-white/70">
        01 / 08
      </span>

      <button
        id="gallery-close"
        type="button"
        aria-label="Cerrar galería"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-white/10 transition hover:bg-white/20"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <!-- IMAGEN -->
    <div class="relative flex min-h-0 w-full max-w-6xl flex-1 items-center justify-center gap-3">

      <button
        id="gallery-prev"
        type="button"
        aria-label="Fotografía anterior"
        class="z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/10 transition hover:bg-white/20 sm:h-12 sm:w-12"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
        </svg>
      </button>

      <img
        id="gallery-image"
        src=""
        alt=""
        class="max-h-full min-w-0 max-w-full flex-1 rounded-xl object-contain"
      />

      <button
        id="gallery-next"
        type="button"
        aria-label="Fotografía siguiente"
        class="z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/10 transition hover:bg-white/20 sm:h-12 sm:w-12"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" />
        </svg>
      </button>

    </div>

    <!-- DESCRIPCIÓN -->
    <p id="gallery-caption" class="mt-4 text-center text-sm text-white/70">
    </p>

  </div>
</dialog>

<script>
  const grid = document.querySelector("#gallery-grid");
  const dialog = document.querySelector("#gallery-lightbox") as HTMLDialogElement;
  const lightboxImage = document.querySelector("#gallery-image") as HTMLImageElement;
  const caption = document.querySelector("#gallery-caption");
  const counter = document.querySelector("#gallery-counter");

  const closeButton = document.querySelector("#gallery-close");
  const prevButton = document.querySelector("#gallery-prev");
  const nextButton = document.querySelector("#gallery-next");

  const items = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".gallery-item")
  );

  let currentIndex = 0;
  let previousFocus: HTMLElement | null = null;

  function showImage(index: number) {
    currentIndex = (index + items.length) % items.length;

    const image = items[currentIndex].querySelector("img");

    if (!image) return;

    lightboxImage.src = image.src;
    lightboxImage.alt = image.alt;
    caption!.textContent = image.alt;

    counter!.textContent =
      `${String(currentIndex + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
  }

  function openGallery(index: number) {
    previousFocus = document.activeElement as HTMLElement;

    showImage(index);
    dialog.showModal();
    closeButton?.focus();
  }

  function closeGallery() {
    dialog.close();
    previousFocus?.focus();
  }

  grid?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".gallery-item");

    if (!button) return;

    openGallery(Number(button.dataset.index));
  });

  closeButton?.addEventListener("click", closeGallery);

  prevButton?.addEventListener("click", () => {
    showImage(currentIndex - 1);
  });

  nextButton?.addEventListener("click", () => {
    showImage(currentIndex + 1);
  });

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) closeGallery();
  });

  dialog.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      showImage(currentIndex - 1);
    }

    if (event.key === "ArrowRight") {
      event.preventDefault();
      showImage(currentIndex + 1);
    }
  });
</script>
